{
  "datasets": [
    {
      "name": "daily_sales",
      "displayName": "Gold Daily Sales",
      "queryLines": [
        "SELECT\n",
        "  order_date,\n",
        "  order_count,\n",
        "  eligible_order_count,\n",
        "  cancelled_order_count,\n",
        "  cancellation_rate,\n",
        "  eligible_revenue\n",
        "FROM\n",
        "  gold_daily_sales"
      ],
      "catalog": "workspace",
      "schema": "ecom_poc"
    },
    {
      "name": "revenue_breakdown",
      "displayName": "Gold Revenue Breakdown",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  country,\n",
        "  order_count,\n",
        "  customer_count,\n",
        "  eligible_revenue,\n",
        "  revenue_share\n",
        "FROM\n",
        "  gold_revenue_breakdown"
      ],
      "catalog": "workspace",
      "schema": "ecom_poc"
    },
    {
      "name": "top_customers",
      "displayName": "Gold Top Customers",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  eligible_spend,\n",
        "  eligible_order_count,\n",
        "  spend_rank\n",
        "FROM\n",
        "  gold_top_customers\n",
        "ORDER BY\n",
        "  spend_rank"
      ],
      "catalog": "workspace",
      "schema": "ecom_poc"
    },
    {
      "name": "payment_success",
      "displayName": "Gold Payment Success",
      "queryLines": [
        "SELECT\n",
        "  payment_method,\n",
        "  transaction_count,\n",
        "  successful_count,\n",
        "  success_rate,\n",
        "  total_amount_usd\n",
        "FROM\n",
        "  gold_payment_success"
      ],
      "catalog": "workspace",
      "schema": "ecom_poc"
    }
  ],
